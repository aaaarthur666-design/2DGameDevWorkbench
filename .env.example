# External capability endpoints. Leave tokens empty in this file.
# The web Worker proxies local task records through the loopback runtime bridge.
WORKBENCH_RUNTIME_URL=http://127.0.0.1:8790
WORKBENCH_RUNTIME_PORT=8790

SPRITE_PIPELINE_API_URL=http://127.0.0.1:7860
SPRITE_PIPELINE_API_TOKEN=
# Full local NativeFramesGeneration operator UI.
NEXT_PUBLIC_SPRITE_PIPELINE_UI_URL=http://127.0.0.1:7860

# Optional persistent map-image API configuration. The editor can also keep a
# key only in the current local runtime process through its settings dialog.
MAP_STITCHER_IMAGE_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
