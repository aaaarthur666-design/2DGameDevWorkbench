# External capability endpoints. Leave tokens empty in this file.
# The web Worker proxies local task records through the loopback runtime bridge.
WORKBENCH_RUNTIME_URL=http://127.0.0.1:8790
WORKBENCH_RUNTIME_PORT=8790

SPRITE_PIPELINE_API_URL=http://127.0.0.1:7860
SPRITE_PIPELINE_API_TOKEN=
# PixelLab reference art shares the key saved in the SpritePipeline settings.
# Optional server-side override; leave blank to use protected local storage.
PIXELLAB_API_KEY=
# Full local NativeFramesGeneration operator UI.
NEXT_PUBLIC_SPRITE_PIPELINE_UI_URL=http://127.0.0.1:7860

# Optional image provider override; the image settings dialog also saves a key
# in protected local storage. Leave blank to use its saved configuration.
IMAGE_ASSETS_PROVIDER=
OPENAI_API_KEY=
# TokenHub is used by SpritePipeline visual review and optional vision profiles.
TOKENHUB_API_KEY=

# Workbench launchers import standalone user jobs/characters once without replacing source assets.
# SPRITE_PIPELINE_IMPORT_USER_ASSETS=0
