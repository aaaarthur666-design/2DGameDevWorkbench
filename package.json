{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vinext dev",
    "dev:interactable": "node scripts/dev.mjs --without-sprite-pipeline",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "sprite-pipeline:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-sprite-pipeline.ps1",
    "sprite-pipeline": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-sprite-pipeline.ps1 -Mode ui",
    "sprite-pipeline:api": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-sprite-pipeline.ps1 -Mode api",
    "workbench": "node scripts/workbench.mjs",
    "workbench:mcp": "node scripts/workbench-mcp.mjs",
    "workbench:http": "node scripts/workbench-http.mjs",
    "test:mcp": "node scripts/test-workbench-mcp.mjs",
    "test:interactable": "node tests/interactable-editor/run.mjs",
    "test:interactable-http": "node tests/interactable-editor/http.mjs",
    "test:interactable-copyworms": "node tests/interactable-editor/copyworms.mjs",
    "test:interactable-web": "vinext build && node tests/interactable-editor/http.mjs --web",
    "schema:interactable": "node scripts/sync-interactable-schema.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test:adapters": "node tests/workbench-adapters/run.mjs",
    "test:http": "node tests/workbench-http/run.mjs",
    "test:map-stitcher": "node tests/map-stitcher/run.mjs",
    "test:dev-supervisor": "node tests/sprite-pipeline-supervisor/run.mjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "sharp": "0.34.5",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "zod-to-json-schema": "3.25.2"
  },
  "type": "module"
}
