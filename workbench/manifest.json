{
  "schemaVersion": 1,
  "workspace": {
    "name": "2D Game Dev Workbench",
    "taskDirectory": "work/tasks",
    "outputDirectory": "outputs"
  },
  "agentAssets": {
    "role": "external-client",
    "skill": ".agents/skills/2d-game-workbench/SKILL.md",
    "expert": "workbench/experts/2d-production-expert.md",
    "clientConfigs": [".mcp.json", ".codex/config.toml"],
    "mcpServer": {
      "transport": "stdio",
      "command": "node",
      "args": ["scripts/workbench-mcp.mjs"],
      "tools": [
        "workbench_list_capabilities",
        "workbench_describe_capability",
        "workbench_prepare_task",
        "workbench_run_task",
        "workbench_get_task"
      ]
    },
    "browserTools": [
      "list_workbench_capabilities",
      "start_workbench_task",
      "map_stitcher_read_summary",
      "map_stitcher_set_view",
      "map_stitcher_import_images",
      "map_stitcher_generate_layer",
      "map_stitcher_create_regions",
      "map_stitcher_export"
    ]
  },
  "capabilities": [
    {
      "id": "sprite-generator",
      "name": "2D 序列帧生成",
      "shortName": "序列帧",
      "description": "从角色设定或动作描述出发，组织并生成可用于游戏的动画帧。",
      "category": "production",
      "workflow": "workbench/workflows/sprite-production.json",
      "ui": {
        "icon": "frames",
        "accent": "violet",
        "status": "ready",
        "route": "/tools/sprite-generator",
        "surface": "editor",
        "capabilities": ["角色动作生成", "播放检查", "逐帧修补", "精灵表导出"]
      },
      "connector": {
        "type": "local-adapter",
        "adapter": "sprite-pipeline",
        "urlEnv": "SPRITE_PIPELINE_API_URL",
        "defaultUrl": "http://127.0.0.1:7860",
        "tokenEnv": "SPRITE_PIPELINE_API_TOKEN"
      },
      "inputSchema": {
        "type": "object",
        "required": ["operation"],
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["create", "create-and-generate", "generate-existing", "get", "export"],
            "description": "与 SpritePipeline REST API 对应的作业操作。"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "description": "已存在的角色预设 ID，对应 Python character_id。"
          },
          "actionId": {
            "type": "string",
            "minLength": 1,
            "description": "已存在的动作预设 ID，对应 Python action_id。"
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "description": "SpritePipeline 返回的持久作业 ID。"
          },
          "provider": {
            "type": "string",
            "enum": ["pixellab", "fixture", "import"]
          },
          "candidateCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "frameCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "description": "期望帧数。"
          },
          "actionDescription": {
            "type": "string",
            "maxLength": 1000
          },
          "loop": {
            "type": "boolean"
          },
          "requestKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "wait": {
            "type": "boolean",
            "description": "仅在明确允许等待外部生成时使用；默认 false。"
          },
          "candidateIndex": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "filename": {
            "type": "string",
            "minLength": 5
          },
          "overwrite": {
            "type": "boolean"
          }
        }
      },
      "outputs": ["jobRecord", "orderedFrames", "spriteSheet", "preview", "metadata"]
    },
    {
      "id": "map-stitcher",
      "name": "地图拼接",
      "shortName": "地图拼接",
      "description": "以 FrameRonin / Pixelwork v2 模型组合地图切片，编辑独立图片图层和矢量区域，并输出可恢复状态与引擎资源。",
      "category": "production",
      "workflow": "workbench/workflows/map-production.json",
      "ui": {
        "icon": "map",
        "accent": "cyan",
        "status": "ready",
        "route": "/tools/map-stitcher",
        "surface": "editor",
        "capabilities": ["切片编排", "六层显示", "四类区域绘制", "Pixelwork v2 状态", "Godot / Unity 导出"]
      },
      "connector": {
        "type": "local-adapter",
        "adapter": "map-stitcher",
        "generationUrlEnv": "MAP_STITCHER_API_URL",
        "generationTokenEnv": "MAP_STITCHER_API_TOKEN"
      },
      "inputSchema": {
        "type": "object",
        "required": ["operation"],
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["compose", "generate-layer"],
            "description": "compose 在本地拼接图片；generate-layer 使用与网页相同的扩图请求。"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "generate-layer 的图片生成提示词。"
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "compose 使用的仓库内图片路径或 data:image URL，按行优先排列。"
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "description": "generate-layer 使用的 data:image URL。"
          },
          "tile": {
            "type": "object",
            "description": "generate-layer 的 FrameRonin 卡片几何信息。"
          },
          "layer": {
            "type": "string",
            "enum": ["overall", "surface", "object", "black", "white"]
          },
          "mask_mode": {
            "type": "string",
            "enum": ["black", "white"]
          },
          "columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "description": "输出地图列数。"
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "description": "可选输出地图行数。"
          },
          "tileSize": {
            "type": "integer",
            "minimum": 4,
            "maximum": 2048,
            "description": "单个地图块的像素尺寸。"
          },
          "checkSeams": {
            "type": "boolean",
            "description": "是否执行边界衔接检查。"
          },
          "regions": {
            "type": "array",
            "items": { "type": "object" },
            "description": "需要写入状态和引擎交付包的区域标注。"
          },
          "stateFormat": {
            "type": "string",
            "enum": ["pixelwork-v2"],
            "description": "可恢复编辑状态的格式。"
          },
          "engineTargets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["godot", "unity"]
            },
            "description": "需要生成的引擎交付包。"
          }
        }
      },
      "outputs": ["generatedLayer", "stitchedMap", "seamReport", "statePackage", "regionAnnotations", "godotPackage", "unityPackage", "metadata"]
    }
  ]
}
